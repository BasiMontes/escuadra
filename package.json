{
  "name": "escuadra",
  "type": "module",
  "agenticAppBase": true,
  "version": "0.1.0",
  "private": true,
  "description": "",
  "license": "ISC",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:types": "SUPABASE_DB_PASSWORD=postgres supabase gen types typescript --local > src/types/supabase.ts",
    "agents:compat": "bun scripts/agent-compatibility.ts",
    "agents:compat:check": "bun scripts/agent-compatibility.ts --check",
    "agents:schema": "bun scripts/agents-schema.ts",
    "agents:schema:check": "bun scripts/agents-schema.ts --check",
    "agents:setup": "bun scripts/agents-setup.ts",
    "api:sync": "bun scripts/sync-openapi.ts",
    "bootstrap:guard": "bun scripts/bootstrap-guard.ts",
    "browser:profiles": "bun scripts/browser-profiles.ts",
    "context:hydrate": "bun scripts/sync-jira-issues.ts pull --include-comments",
    "context:map": "bun scripts/context-map.ts",
    "docs:check": "bun scripts/lint-docs.ts",
    "env:set": "bun scripts/env-set.ts",
    "format:check": "prettier --check '**/*.{json,yml,yaml,css,scss,html}' --ignore-path .prettierignore",
    "format:fix": "prettier --write '**/*.{json,yml,yaml,css,scss,html}' --ignore-path .prettierignore",
    "harness:env": "bun scripts/harness-env.ts",
    "harness:env:check": "bun scripts/harness-env.ts --check",
    "instructions:audit": "bun scripts/instructions-audit.ts",
    "instructions:check": "bun scripts/lint-instructions.ts",
    "jira:check": "bun scripts/check-jira-setup.ts",
    "jira:sync-fields": "bun scripts/sync-jira-fields.ts",
    "jira:sync-issues": "bun scripts/sync-jira-issues.ts",
    "jira:sync-link-types": "bun scripts/sync-jira-link-types.ts",
    "jira:sync-workflows": "bun scripts/sync-jira-workflows.ts",
    "jira:components": "bun scripts/sync-jira-components.ts",
    "jira:url": "bun scripts/atlassian-url.ts",
    "lint:check": "eslint .",
    "lint:cached": "eslint --cache --cache-location node_modules/.cache/eslint/.eslintcache .",
    "oxlint:check": "oxlint -c .oxlintrc.json",
    "lint:fix": "eslint --cache --cache-location node_modules/.cache/eslint/.eslintcache --fix .",
    "onboarding": "bun scripts/onboarding.ts",
    "prepare": "husky && bun scripts/harness-env.ts --placeholders",
    "repo:check": "bun run adr:check && bun run cycles:check && bun run knip:check && bun scripts/tooling-check.ts repo && bun run vars:check && bun run vars:env:check && bun run vars:schema:check && bun run skills:check && bun run skills:registry:check && bun run docs:check && bun run shared:check && bun run instructions:check && bun run agents:compat:check && bun run agents:schema:check && bun run guard:manifest:check && bun run guard:example:check",
    "repo:fix": "bun run format:fix && bun run lint:fix && bun run types:check && bun run vars:check && bun run vars:env:check && bun run vars:schema && bun run skills:check && bun run skills:registry:check && bun run docs:check && bun run instructions:check && bun run agents:compat:check",
    "setup:doctor": "bun cli/doctor.ts",
    "setup": "bun cli/preflight.ts --for setup --gate && bun cli/install.ts",
    "shared:check": "bun scripts/shared-check.ts",
    "skills:check": "bun scripts/lint-skills.ts",
    "skills:registry:check": "bun scripts/build-skill-registry.ts --check",
    "skills:registry": "bun scripts/build-skill-registry.ts",
    "sync": "bun cli/update-boilerplate.ts",
    "test": "bun run test:app && bun run test:tooling",
    "test:app": "bun test --preload ./test/dom-setup.ts ./src",
    "test:app:random": "bun test --parallel --preload ./test/dom-setup.ts --randomize ./src",
    "module:add": "bun scripts/module-add.ts",
    "project:name": "bun scripts/project-name.ts",
    "modules:verify": "bun scripts/modules-verify.ts",
    "test:db": "supabase test db",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:e2e:smoke": "bun scripts/e2e.ts --grep @smoke",
    "ci:e2e-wallclock": "bun scripts/e2e-wallclock.ts",
    "test:tooling": "bun test --pass-with-no-tests cli/ scripts/ && bun test --pass-with-no-tests --cwd .agents/skills/acli/scripts",
    "tooling:lint:check": "bun scripts/tooling-check.ts lint",
    "tooling:types:check": "bun scripts/tooling-check.ts types",
    "types:check": "next typegen && bun check",
    "up": "bun cli/update-boilerplate.ts",
    "worktree:audit": "bun scripts/worktree-audit.ts",
    "worktree:provision": "bun scripts/provision-worktree.ts",
    "vars:check": "bun scripts/lint-vars.ts",
    "git:policy": "bun scripts/git-policy.ts",
    "github:project:bootstrap": "bun scripts/github-project-bootstrap.ts",
    "github:releases:sync": "bun scripts/github-releases.ts",
    "guard:example:check": "bun scripts/guard-example-check.ts",
    "guard:manifest": "bun scripts/guard-manifest.ts",
    "guard:manifest:check": "bun scripts/guard-manifest.ts --check",
    "vars:env:check": "bun scripts/check-vars.ts",
    "vars:schema": "bun scripts/env-schema.ts",
    "vars:schema:check": "bun scripts/env-schema.ts --check",
    "adr:check": "bun scripts/check-adrs.ts",
    "adr:reconcile": "bun scripts/adr-reconcile.ts",
    "cycles:check": "bun scripts/check-import-cycles.ts",
    "git:checks": "bun scripts/required-checks.ts",
    "git:promote": "bun scripts/git-promote.ts",
    "context:stale": "bun scripts/check-map-staleness.ts",
    "jira:closure-evidence": "bun scripts/check-closure-evidence.ts",
    "knip:check": "knip --no-progress",
    "test:e2e:safari": "NAVEGADOR=webkit playwright test --grep-invert @visual",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "check:all": "bun run repo:check && bun run test && bun run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clack/prompts": "^1.8.1",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@inquirer/prompts": "^8.7.5",
    "@sentry/nextjs": "^11.18.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "boxen": "^9.0.0",
    "class-variance-authority": "^0.7.1",
    "cli-table3": "^0.6.5",
    "cn": "^0.5.2",
    "figures": "^6.1.0",
    "lucide-react": "^1.80.0",
    "next": "^16.4.6",
    "nodemailer": "^10.6.1",
    "picocolors": "^1.1.1",
    "posthog-js": "^1.455.3",
    "posthog-node": "^6.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.40.0",
    "shadcn": "^4.23.1",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@axe-core/playwright": "^4.14.1",
    "@eslint-react/eslint-plugin": "^5.30.6",
    "@happy-dom/global-registrator": "^21.0.4",
    "@next/eslint-plugin-next": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^25.9.9",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-refresh": "^0.5.8",
    "husky": "^9.1.7",
    "knip": "^6.47.0",
    "lint-staged": "^17.6.0",
    "oxlint": "1.94.0",
    "postcss": "^8.5.33",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "varlock": "1.20.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint -c .oxlintrc.json --no-error-on-unmatched-pattern"
    ],
    "*.{json,yml,yaml,css,scss,html}": [
      "prettier --write --ignore-path .prettierignore"
    ]
  }
}
